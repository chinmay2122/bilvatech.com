{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/homepage", "destination": "/", "permanent": true },
    { "source": "/homepage-original", "destination": "/", "permanent": true },
    { "source": "/trialhomepage", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/404",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
